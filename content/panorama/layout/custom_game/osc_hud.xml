<root>
    <styles>
        <include src="s2r://panorama/styles/dotastyles.vcss_c" />
        <include src="file://{resources}/styles/custom_game/osc_theme.css" />
        <include src="file://{resources}/styles/custom_game/osc_hud.css" />
    </styles>
    <scripts>
        <include src="file://{resources}/scripts/custom_game/osc_core.js" />
        <include src="file://{resources}/scripts/custom_game/osc_version.js" />
        <include src="file://{resources}/scripts/custom_game/osc_timer.js" />
        <include src="file://{resources}/scripts/custom_game/osc_chaos_round.js" />
        <include src="file://{resources}/scripts/custom_game/osc_ability_popup.js" />
        <include src="file://{resources}/scripts/custom_game/osc_rotation_choice.js" />
        <include src="file://{resources}/scripts/custom_game/osc_anchor.js" />
        <include src="file://{resources}/scripts/custom_game/osc_casino.js" />
        <include src="file://{resources}/scripts/custom_game/osc_chaos_shop.js" />
        <include src="file://{resources}/scripts/custom_game/osc_help.js" />
        <include src="file://{resources}/scripts/custom_game/osc_notification_feed.js" />
        <include src="file://{resources}/scripts/custom_game/osc_hud.js" />
    </scripts>

    <Panel class="OSCRoot" hittest="false">
        <!-- Виньетка хаоса: первой, чтобы лежать под остальным HUD -->
        <Panel id="ChaosVignette" hittest="false">
            <Panel id="VignetteTop" class="VignetteEdge" hittest="false" />
            <Panel id="VignetteBottom" class="VignetteEdge" hittest="false" />
            <Panel id="VignetteLeft" class="VignetteEdge" hittest="false" />
            <Panel id="VignetteRight" class="VignetteEdge" hittest="false" />
        </Panel>

        <!-- Экранные хаос-раунды «Туннель» и «Лас-Вегас» (osc_chaos_round.js) -->
        <Panel id="TunnelMask" hittest="false">
            <Panel class="TunnelFillV" hittest="false" />
            <Panel id="TunnelRow" hittest="false">
                <Panel class="TunnelFillH" hittest="false" />
                <Panel id="TunnelHole" hittest="false" />
                <Panel class="TunnelFillH" hittest="false" />
            </Panel>
            <Panel class="TunnelFillV" hittest="false" />
        </Panel>
        <Panel id="DoomOverlay" hittest="false">
            <Panel id="DoomTint" hittest="false" />
            <Panel id="DoomNoiseA" class="VhsNoise" hittest="false" />
            <Panel id="DoomNoiseB" class="VhsNoise" hittest="false" />
            <Panel id="DoomPixels" hittest="false" />
            <Panel id="VhsTracking" hittest="false" />
            <!-- Выпуклый кинескоп: затемнение к краям, блик, рамка со скруглёнными углами -->
            <Panel id="CrtVignette" hittest="false" />
            <Panel id="CrtGlare" hittest="false" />
            <Panel id="CrtEdge" hittest="false" />
            <Panel id="CrtCornerTL" class="CrtCorner" hittest="false" />
            <Panel id="CrtCornerTR" class="CrtCorner" hittest="false" />
            <Panel id="CrtCornerBL" class="CrtCorner" hittest="false" />
            <Panel id="CrtCornerBR" class="CrtCorner" hittest="false" />
            <Panel id="VhsOsd" hittest="false">
                <Label class="VhsOsdText" text="▶ PLAY" hittest="false" />
                <Label id="VhsCounter" class="VhsOsdText" text="00:00:00" hittest="false" />
            </Panel>
        </Panel>
        <Panel id="VegasOverlay" hittest="false">
            <Panel id="VegasOil" hittest="false">
                <Panel id="OilBlob1" class="OilBlob" hittest="false" />
                <Panel id="OilBlob2" class="OilBlob" hittest="false" />
                <Panel id="OilBlob3" class="OilBlob" hittest="false" />
                <Panel id="OilBlob4" class="OilBlob" hittest="false" />
                <Panel id="OilBlob5" class="OilBlob" hittest="false" />
                <Panel id="OilBlob6" class="OilBlob" hittest="false" />
            </Panel>
            <Panel id="VegasTint" hittest="false" />
            <Panel id="VegasFringeLeft" class="VegasFringe" hittest="false" />
            <Panel id="VegasFringeRight" class="VegasFringe" hittest="false" />
        </Panel>

        <Panel id="NotificationFeed" hittest="false" />

        <Label id="VersionLabel" class="OSCTextSmall OSCMuted" hittest="false" />

        <Panel id="TimerPanel" class="OSCSurface OSCChaos" hittest="false">
            <Panel id="TimerRing" hittest="false">
                <Panel id="TimerRingTrack" hittest="false" />
                <Panel id="TimerRingFill" hittest="false" />
                <Panel id="TimerRingHole" hittest="false" />
            </Panel>
            <Label id="TimerLabel" class="OSCTextBody OSCBold" />
            <!-- Якорь: виден, пока следующая ротация пропускается (osc_anchor.js) -->
            <Panel id="AnchorBadge" hittest="true">
                <DOTAAbilityImage id="AnchorIcon" abilityname="tidehunter_anchor_smash"
                    hittest="false" />
            </Panel>
        </Panel>

        <Panel id="ChaosRoundPanel" class="OSCSurface OSCChaos" hittest="false">
            <Label id="ChaosRoundHeader" class="OSCTextSmall OSCCaps OSCBold OSCChaosText"
                text="#osc_hud_chaos_header" />
            <Label id="ChaosRoundTitle" class="OSCTextTitle" text="#osc_hud_chaos_waiting" />
            <Label id="ChaosRoundDescription" class="OSCTextBody OSCMuted"
                text="#osc_hud_chaos_soon_desc" />
            <Label id="ChaosRoundTimer" class="OSCTextBody OSCBold OSCGold" text="--:--" />
        </Panel>

        <Panel id="Popup" hittest="false">
            <Panel id="PopupCard" hittest="false">
                <DOTAAbilityImage id="PopupIcon" hittest="false" />
                <Panel id="PopupFlash" hittest="false" />
            </Panel>
            <Label id="PopupTitle" class="OSCTextBody OSCCaps OSCChaosText" />
            <Label id="PopupName" class="OSCTextDisplay" />
        </Panel>

        <Panel id="CasinoPanel" hittest="true">
            <Panel id="CasinoWindow" class="OSCSurface OSCChaos" hittest="true">
                <Label id="CasinoTitle" class="OSCTextTitle OSCGold" text="#osc_casino_title" />
                <Label id="CasinoDescription" class="OSCTextSmall OSCMuted" text="" />
                <Label id="CasinoBalance" class="OSCTextBody OSCBold OSCGold" text="" />
                <Panel id="CasinoStakeRow">
                    <Label id="CasinoStakeLabel" class="OSCTextBody" text="#osc_casino_stake_label" />
                    <TextEntry id="CasinoStake" text="250" maxchars="8" />
                    <Label id="CasinoStakeLimit" class="OSCTextSmall OSCMuted" text="" />
                </Panel>
                <!-- Ставка предметом: заполняется из osc_casino.js -->
                <Panel id="CasinoItemsRow" class="Hidden">
                    <Label id="CasinoItemsLabel" class="OSCTextSmall OSCMuted"
                        text="#osc_casino_items_label" />
                    <Panel id="CasinoItems" />
                    <Label id="CasinoItemsEmpty" class="OSCTextSmall OSCMuted Hidden"
                        text="#osc_casino_items_empty" />
                </Panel>
                <Panel id="CasinoReels">
                    <Label id="CasinoReel1" class="CasinoReel" text="7" />
                    <Label id="CasinoReel2" class="CasinoReel" text="★" />
                    <Label id="CasinoReel3" class="CasinoReel" text="♦" />
                </Panel>
                <Label id="CasinoResult" class="OSCTextBody" text="#osc_casino_idle" />
                <Panel id="CasinoButtons">
                    <Button id="CasinoSpinButton" class="OSCButton OSCButtonPrimary"
                        onactivate="OSC.Casino.Spin()">
                        <Label text="#osc_casino_btn_spin" />
                    </Button>
                    <Button id="CasinoCloseButton" class="OSCButton" onactivate="OSC.Casino.Close()">
                        <Label text="#osc_casino_btn_close" />
                    </Button>
                </Panel>
            </Panel>
            <!-- Слой для частиц поверх окна -->
            <Panel id="CasinoFx" hittest="false" />
        </Panel>

        <!-- Справка (osc_help.js): кнопка «?» рядом с Хаос-лавкой и панель правил -->
        <Button id="HelpButton" class="OSCButton" onactivate="OSC.Help.Toggle()">
            <Label text="#osc_hud_help_button" />
        </Button>
        <Panel id="HelpPanel" class="OSCSurface OSCChaos" hittest="true">
            <Label id="HelpTitle" class="OSCTextTitle OSCChaosText" text="#osc_hud_help_title" />
            <Panel id="HelpSections">
                <Label class="HelpHeading OSCTextBody OSCBold OSCGold" text="#osc_hud_help_rotation_title" />
                <Label class="HelpText OSCTextSmall" text="#osc_hud_help_rotation_text" />
                <Label class="HelpHeading OSCTextBody OSCBold OSCGold" text="#osc_hud_help_anchor_title" />
                <Label class="HelpText OSCTextSmall" text="#osc_hud_help_anchor_text" />
                <Label class="HelpHeading OSCTextBody OSCBold OSCGold" text="#osc_hud_help_rarity_title" />
                <Label class="HelpText OSCTextSmall" text="#osc_hud_help_rarity_text" />
                <Label class="HelpHeading OSCTextBody OSCBold OSCGold" text="#osc_hud_help_chaos_rounds_title" />
                <Label class="HelpText OSCTextSmall" text="#osc_hud_help_chaos_rounds_text" />
                <Label class="HelpHeading OSCTextBody OSCBold OSCGold" text="#osc_hud_help_chaos_shop_title" />
                <Label class="HelpText OSCTextSmall" text="#osc_hud_help_chaos_shop_text" />
                <Label class="HelpHeading OSCTextBody OSCBold OSCGold" text="#osc_hud_help_casino_title" />
                <Label class="HelpText OSCTextSmall" text="#osc_hud_help_casino_text" />
                <Label class="HelpHeading OSCTextBody OSCBold OSCGold" text="#osc_hud_help_chaos_sphere_title" />
                <Label class="HelpText OSCTextSmall" text="#osc_hud_help_chaos_sphere_text" />
            </Panel>
            <Button id="HelpClose" class="OSCButton" onactivate="OSC.Help.Close()">
                <Label text="#osc_hud_help_close" />
            </Button>
        </Panel>

        <!-- Хаос-лавка (osc_chaos_shop.js): кнопка рядом со стандартным
             магазином и панель товаров; строки товаров создаются из JS -->
        <Button id="ChaosShopButton" class="OSCButton OSCButtonPrimary Hidden"
            onactivate="OSC.ChaosShop.Toggle()">
            <Label text="#osc_shop_button" />
        </Button>
        <Panel id="ChaosShopPanel" class="OSCSurface OSCChaos" hittest="true">
            <Label id="ChaosShopTitle" class="OSCTextTitle OSCChaosText" text="#osc_shop_title" />
            <Panel id="ChaosShopItems" />
            <Button id="ChaosShopClose" class="OSCButton" onactivate="OSC.ChaosShop.Close()">
                <Label text="#osc_shop_close" />
            </Button>
        </Panel>

        <!-- Выбор следующей способности: последним, поверх затемнения казино
             (иначе #CasinoPanel перехватывает клики). Кликабельны только карточки -->
        <Panel id="ChoicePanel" class="OSCSurface OSCChaos" hittest="false">
            <Panel id="ChoiceHeaderRow" hittest="false">
                <Label id="ChoiceHeader" class="OSCTextSmall OSCCaps OSCBold OSCChaosText"
                    hittest="false" />
                <Label id="ChoiceTimer" class="OSCTextSmall OSCBold OSCGold" hittest="false" />
            </Panel>
            <Panel id="ChoiceCards" hittest="false" />
            <Panel id="ChoiceProgress" hittest="false">
                <Panel id="ChoiceProgressFill" hittest="false" />
            </Panel>
        </Panel>
    </Panel>
</root>